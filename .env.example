# Copy to .env.local and fill in. Never commit real values.

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Clerk (customer accounts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_ADMIN_CLERK_USER_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://www.buyfromsaint.com

# Payments
PAYSTACK_SECRET_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Email and SMS
RESEND_API_KEY=
RESEND_FROM_EMAIL="The Saint's TechNet <notifications@buyfromsaint.com>"
TERMII_API_KEY=
TERMII_SENDER_ID=
OWNER_EMAIL=

# AI
ANTHROPIC_API_KEY=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cron and internal server-to-server calls
CRON_SECRET=

# Admin PIN: bcrypt hash of the 6-digit PIN
#   node -e "require('bcryptjs').hash('123456', 12).then(console.log)"
ADMIN_PIN_HASH=
# Optional: separate secret for signing the admin session cookie
ADMIN_SESSION_SECRET=

# Receipt issuance (all optional)
RECEIPT_BUSINESS_ADDRESS=
RECEIPT_BUSINESS_TIN=
RECEIPT_FROM_EMAIL=
RECEIPT_REPLY_TO=
RECEIPT_BCC_EMAIL=

# Analytics (optional)
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
